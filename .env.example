# Kopieer naar .env.local en vul in — .env.local staat in .gitignore en wordt nooit gecommit.

# Postgres (Neon via Vercel) — verplicht
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Ongepoolde variant voor schemamigraties (drizzle.config.ts); zelfde database, andere Neon-poort
DATABASE_URL_UNPOOLED=

# Auth.js sessie-secret — verplicht (genereer bijv. met `openssl rand -base64 32`)
AUTH_SECRET=

# Vercel Blob (foto's voor producenten/aanbod, store "onlyfarms-media") — verplicht voor uploads
BLOB_READ_WRITE_TOKEN=

# Google Maps/Places (openingstijden-, telefoon- en website-sync) — optioneel, zie scripts/google-sync.ts
GOOGLE_MAPS_API_KEY=

# Alleen nodig voor de eenmalige seed-import uit de oude deboervinder-sheet
SHEET_ID=

# Realtime lijsten (Pusher Channels) — optioneel; zonder keys valt de UI terug op polling
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# Klaviyo server-side events (Sally's flows) — optioneel
KLAVIYO_PRIVATE_KEY=
